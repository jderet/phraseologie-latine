# Copier ce fichier en .env, puis adapter les valeurs.
DJANGO_DEBUG=True
# Générer une clé : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Sans DATABASE_URL, le site utilise un fichier SQLite local.
# Pour PostgreSQL (docker compose up -d) :
# DATABASE_URL=postgres://phraseologie:phraseologie@localhost:5432/phraseologie

# Adresse d'expédition des e-mails (activation du compte, mot de passe oublié).
# En local, les e-mails s'affichent dans le terminal.
# DJANGO_DEFAULT_FROM_EMAIL=ne-pas-repondre@exemple.org

# Contributions par jour d'un nouveau compte, jusqu'à sa première contribution validée.
# NEW_ACCOUNT_DAILY_LIMIT=10

# Jours après lesquels une inscription jamais activée est effacée.
# PENDING_SIGNUP_RETENTION_DAYS=7

# Pages légales : identité de l'éditeur et de l'hébergeur, obligatoires avant l'ouverture
# (python manage.py check --deploy signale ce qui manque). L'adresse de l'éditeur est
# facultative quand il agit à titre non professionnel : celle de l'hébergeur suffit alors.
# LEGAL_PUBLISHER_NAME=Prénom Nom
# LEGAL_PUBLISHER_ADDRESS=
# LEGAL_CONTACT_EMAIL=contact@exemple.org
# LEGAL_HOST_NAME=Nom de l'hébergeur
# LEGAL_HOST_ADDRESS=Adresse postale de l'hébergeur
# LEGAL_HOST_PHONE=+33 1 23 45 67 89

# Dépôt public du code, indiqué en pied de page (licence AGPL-3.0).
# SOURCE_CODE_URL=https://github.com/jderet/phraseologie-latine

# Dossier du corpus Perseus ; par défaut canonical-latinLit à la racine du projet.
# PERSEUS_LATIN_DIR=/chemin/vers/canonical-latinLit

# Dossier des exports complets des données publiques (manage.py export_data).
# EXPORT_DIR=/chemin/vers/exports
