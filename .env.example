# Copier ce fichier en .env, puis adapter les valeurs.
DJANGO_DEBUG=True
# Générer une clé : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Sans DATABASE_URL, le site utilise un fichier SQLite local.
# Pour PostgreSQL (docker compose up -d) :
# DATABASE_URL=postgres://phraseologie:phraseologie@localhost:5432/phraseologie

# Adresse d'expédition des e-mails (activation du compte, mot de passe oublié).
# En local, les e-mails s'affichent dans le terminal.
# DJANGO_DEFAULT_FROM_EMAIL=ne-pas-repondre@exemple.org

# Dossier du corpus Perseus ; par défaut canonical-latinLit à la racine du projet.
# PERSEUS_LATIN_DIR=/chemin/vers/canonical-latinLit
