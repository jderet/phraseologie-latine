      <div type="edition" n="urn:cts:latinLit:phi0588.abo024.perseus-lat2">
        <div type="textpart" subtype="chapter" n="1">
          <head>M. Porcius Cato</head>
          <p><seg type="section" n="1">M. Cato, ortus municipio Tusculo,</seg>
            <seg type="section" n="2">primum stipendium meruit <note>annorum decem septemque</note> in Sicilia.</seg></p>
        </div>
        <div type="textpart" subtype="chapter">
          <p><seg type="section" n="1">Consulatum gessit cum L. Valerio Flacco.</seg></p>
        </div>
      </div>
