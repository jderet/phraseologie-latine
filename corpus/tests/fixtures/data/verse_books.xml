  <text>
    <body>
      <div type="edition" n="urn:cts:latinLit:phi1276.phi001.perseus-lat2">
        <div type="textpart" subtype="book" n="1">
          <div type="textpart" subtype="poem" n="1">
            <head>Satura I</head>
            <l n="1">Semper ego auditor tantum?</l>
            <l n="2">numquamne reponam</l>
            <l>vexatus totiens</l>
          </div>
        </div>
        <div type="textpart" subtype="book" n="2">
          <div type="textpart" subtype="poem" n="2">
            <lg>
              <l n="1">Ultra Sauromatas &dagger; fugere hinc libet</l>
              <l n="2">et glacialem Oceanum</l>
            </lg>
          </div>
        </div>
      </div>
    </body>
  </text>
