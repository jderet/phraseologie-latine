#: accounts/admin.py:29
msgid "Dates"
msgstr "Dates"

#: accounts/apps.py:8
msgid "Comptes"
msgstr "Accounts"

#: accounts/forms.py:21
msgid "Je déclare avoir 18 ans ou plus."
msgstr "I declare that I am 18 or older."

#: accounts/forms.py:22
msgid "La plateforme est réservée aux personnes majeures."
msgstr "The platform is for adults only."

#: accounts/forms.py:39
msgid "Un compte existe déjà avec cette adresse e-mail."
msgstr "An account already exists with this email address."

#: accounts/forms.py:61
msgid ""
"Adresse e-mail ou mot de passe incorrect. Si vous venez de vous inscrire, "
"activez d’abord votre compte avec le lien reçu par e-mail."
msgstr ""
"Incorrect email address or password. If you have just signed up, first "
"activate your account with the link sent to you by email."

#: accounts/forms.py:81
msgid "Mot de passe"
msgstr "Password"

#: accounts/forms.py:93
msgid "Mot de passe incorrect."
msgstr "Incorrect password."

#: accounts/models.py:19
msgid "Un identifiant ORCID s’écrit sous la forme 0000-0002-1825-0097."
msgstr "An ORCID iD is written as 0000-0002-1825-0097."

#: accounts/models.py:28
msgid "Cet identifiant ORCID n’existe pas : vérifiez les chiffres."
msgstr "This ORCID iD does not exist: check the digits."

#: accounts/models.py:75
msgid "adresse e-mail"
msgstr "email address"

#: accounts/models.py:77
msgid "nom affiché"
msgstr "display name"

#: accounts/models.py:79
msgid "Nom visible sur vos contributions et votre page publique."
msgstr "Name shown on your contributions and your public page."

#: accounts/models.py:86
msgid "Facultatif, par exemple 0000-0002-1825-0097."
msgstr "Optional, for example 0000-0002-1825-0097."

#: accounts/models.py:88
msgid "majorité déclarée"
msgstr "declared adult"

#: accounts/models.py:90
msgid "date de la déclaration de majorité"
msgstr "date of the age declaration"

#: accounts/models.py:93
msgid "langue d’interface"
msgstr "interface language"

#: accounts/models.py:99
msgid "compte confirmé"
msgstr "confirmed account"

#: accounts/models.py:102
msgid ""
"Vrai après une première contribution validée : les limites des nouveaux "
"comptes ne s’appliquent plus."
msgstr ""
"True after a first validated contribution: the limits on new accounts no "
"longer apply."

#: accounts/models.py:106
msgid "anonymisé le"
msgstr "anonymized on"

#: accounts/models.py:115
msgid "utilisateur"
msgstr "user"

#: accounts/models.py:116
msgid "utilisateurs"
msgstr "users"

#: accounts/models.py:131
msgid "Contributeur anonyme"
msgstr "Anonymous contributor"

#: accounts/roles.py:19
msgid "contributeur"
msgstr "contributor"

#: accounts/roles.py:20
msgid "relecteur"
msgstr "reviewer"

#: accounts/roles.py:21
msgid "administrateur"
msgstr "administrator"

#: accounts/views.py:69
msgid "Votre compte est activé. Bienvenue !"
msgstr "Your account is active. Welcome!"

#: accounts/views.py:91
msgid "Vos informations sont enregistrées."
msgstr "Your details have been saved."

#: accounts/views.py:110
msgid "Votre compte est supprimé. Vos contributions restent, sans votre nom."
msgstr "Your account has been deleted. Your contributions remain, without your name."

#: templates/accounts/account.html:4 templates/accounts/account.html:8
#: templates/base.html:15
msgid "Mon compte"
msgstr "My account"

#: templates/accounts/account.html:11
