#, python-format
msgid "%(count)d phrase ajoutée"
msgid_plural "%(count)d phrases ajoutées"
msgstr[0] "%(count)d sentence added"
msgstr[1] "%(count)d sentences added"

#: translations/steps.py:183
#, python-format
msgid "%(count)d phrase modifiée"
msgid_plural "%(count)d phrases modifiées"
msgstr[0] "%(count)d sentence edited"
msgstr[1] "%(count)d sentences edited"

