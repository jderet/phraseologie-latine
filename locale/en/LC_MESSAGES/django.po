msgstr "The topic is edited."

#: translations/workshop_views.py:307
msgid "Le sujet est rouvert."
msgstr "The topic is reopened."

#: translations/workshop_views.py:307
msgid "Le sujet est fermé."
msgstr "The topic is closed."

#: translations/workshop_views.py:353
msgid "Le terme entre dans le glossaire."
msgstr "The term enters the glossary."

#: translations/workshop_views.py:357
msgid "Le terme est proposé : le créateur du projet ou un relecteur décide."
msgstr ""
"The term is proposed: the creator of the project or a reviewer decides."

#: translations/workshop_views.py:400
msgid "Le terme est modifié."
msgstr "The term is edited."

#: translations/workshop_views.py:420
msgid "Le terme est adopté."
msgstr "The term is adopted."

#: translations/workshop_views.py:422
