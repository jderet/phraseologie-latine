#: translations/views.py:1589
msgid "La phrase est acceptée : elle entre dans votre texte de travail."
msgstr "The sentence is accepted: it enters your working text."

#: translations/views.py:1592
msgid "La phrase est refusée."
msgstr "The sentence is refused."

#: translations/views.py:1644
#, python-format
msgid "L’étape %(number)d est créée."
msgstr "Step %(number)d is created."

#: translations/workshop_views.py:120
