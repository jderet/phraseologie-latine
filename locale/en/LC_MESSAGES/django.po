msgstr "Publication"

#: translations/services.py:766
msgid "Écrivez un message : ce qui a changé depuis l’étape précédente."
msgstr "Write a message: what changed since the previous step."

#: translations/services.py:798
msgid "La version de référence doit être une version publiée de ce projet."
msgstr "The reference version must be a published version of this project."

#: translations/services.py:802
msgid "Choix de la version de référence"
msgstr "Choice of the reference version"

#: translations/services.py:821
msgid "Dites ce qu’il faudrait changer, ou ce que vous remarquez."
msgstr "Say what should change, or what you notice."

#: translations/sources.py:65
msgid "Ajoutez au moins une phrase."
msgstr "Add at least one sentence."

#: translations/sources.py:83
msgid "Rien n’a changé dans cette phrase."
msgstr "Nothing has changed in this sentence."

#: translations/sources.py:91
msgid "Coupez la phrase en au moins deux parties, une par ligne."
msgstr "Cut the sentence into at least two parts, one per line."

#: translations/sources.py:97
msgid ""
"Une scission ne change aucun mot : recollées, les parties doivent redonner "
"la phrase. Pour changer ses mots, modifiez la phrase."
msgstr ""
"A split changes no word: joined again, the parts must give back the "
"sentence. To change its words, edit the sentence."

#: translations/sources.py:111
msgid "Cette phrase n’existe plus dans le texte : rechargez la page."
msgstr "This sentence is no longer in the text: reload the page."

#: translations/sources.py:202
#, python-format
msgid "Phrase %(first)d ajoutée"
msgid_plural "Phrases %(first)d à %(last)d ajoutées"
msgstr[0] "Sentence %(first)d added"
msgstr[1] "Sentences %(first)d to %(last)d added"

#: translations/steps.py:160
msgid "latin inchangé"
msgstr "Latin unchanged"

#: translations/steps.py:162
#, python-format
msgid "%(count)d phrase traduite changée"
msgid_plural "%(count)d phrases traduites changées"
msgstr[0] "%(count)d translated sentence changed"
msgstr[1] "%(count)d translated sentences changed"

#: translations/steps.py:167
#, python-format
msgid "(dont %(count)d effacée)"
msgid_plural "(dont %(count)d effacées)"
msgstr[0] "(%(count)d of them erased)"
msgstr[1] "(%(count)d of them erased)"

