msgstr[0] "%(count)d sentence saved."
msgstr[1] "%(count)d sentences saved."

#: translations/views.py:1034
msgid "Rien n’est enregistré : corrigez les phrases signalées."
msgstr "Nothing was saved: correct the sentences marked below."

#: translations/views.py:1228
msgid "Cette version est déjà publiée."
msgstr "This version is already published."

#: translations/views.py:1243
msgid "La version est publiée."
msgstr "The version has been published."

#: translations/views.py:1353
msgid "La copie est créée : c’est votre brouillon, visible de vous seul."
