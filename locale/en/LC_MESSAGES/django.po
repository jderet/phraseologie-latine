#, python-format
msgid "%(count)d scission"
msgid_plural "%(count)d scissions"
msgstr[0] "%(count)d split"
msgstr[1] "%(count)d splits"

#: translations/sync.py:106
msgid "Mise à jour depuis l’originale"
msgstr "Update from the original"

#: translations/topics.py:48
msgid "Cette phrase n’appartient pas au texte du projet."
msgstr "This sentence does not belong to the text of the project."

#: translations/topics.py:75
msgid "Sujet rouvert"
msgstr "Topic reopened"

#: translations/topics.py:75
msgid "Sujet fermé"
msgstr "Topic closed"

#: translations/views.py:196
msgid "Le texte est ajouté."
msgstr "The text has been added."

#: translations/views.py:329
msgid ""
"Le changement est ajouté à votre proposition. Envoyez-la quand elle est "
"prête."
msgstr "The change is added to your proposal. Send it when it is ready."

#: translations/views.py:334
msgid "Le texte est modifié. Chaque version l’intégrera à sa prochaine étape."
msgstr "The text is changed. Each version will include it at its next step."

#: translations/views.py:373
#, python-format
msgid "Modifier la phrase %(number)d"
msgstr "Edit sentence %(number)d"

#: translations/views.py:375
msgid ""
"La phrase est remplacée ; l’ancienne reste dans les étapes qui l’ont figée. "
"Le latin déjà écrit reste attaché à la phrase."
msgstr ""
"The sentence is replaced; the former one remains in the steps that froze it. "
"The Latin already written stays with the sentence."

#: translations/views.py:379
msgid "Enregistrer la phrase"
msgstr "Save the sentence"

#: translations/views.py:403
#, python-format
msgid "Scinder la phrase %(number)d"
msgstr "Split sentence %(number)d"

#: translations/views.py:405
msgid ""
"Allez à la ligne là où la phrase doit être coupée. Les mots ne changent "
"pas ; le latin déjà écrit reste sur la première partie."
msgstr ""
"Start a new line where the sentence is to be cut. The words do not change; "
"the Latin already written stays on the first part."

#: translations/views.py:409
msgid "Scinder la phrase"
msgstr "Split the sentence"

#: translations/views.py:431
#, python-format
msgid "Fusionner les phrases %(number)d et %(next)d"
msgstr "Merge sentences %(number)d and %(next)d"

#: translations/views.py:434
msgid ""
"Les deux phrases n’en font plus qu’une. Dans chaque version, leurs latins "
"sont mis bout à bout."
msgstr ""
"The two sentences become one. In each version, their Latin is joined end to "
"end."

#: translations/views.py:438
msgid "Fusionner"
msgstr "Merge"

#: translations/views.py:458
msgid "Ajouter des phrases à la fin"
msgstr "Add sentences at the end"

#: translations/views.py:460
#, python-format
msgid "Ajouter des phrases après la phrase %(number)d"
msgstr "Add sentences after sentence %(number)d"

#: translations/views.py:465
msgid ""
"Collez le texte : il sera découpé en phrases, que vous vérifierez avant "
"d’enregistrer."
msgstr ""
"Paste the text: it will be split into sentences, which you will check before "
"saving."

#: translations/views.py:476
msgid ""
"Vérifiez le découpage : une phrase par ligne, une ligne vide entre deux "
"paragraphes."
msgstr ""
"Check the split: one sentence per line, a blank line between two paragraphs."

#: translations/views.py:478
msgid "Ajouter les phrases"
msgstr "Add the sentences"

#: translations/views.py:572 translations/views.py:1466
msgid "La proposition est envoyée."
msgstr "The proposal is sent."

#: translations/views.py:582
msgid "La proposition est adoptée : le texte est modifié."
msgstr "The proposal is adopted: the text is changed."

#: translations/views.py:583
msgid "La proposition est refusée."
msgstr "The proposal is refused."

#: translations/views.py:584 translations/views.py:1605
msgid "La proposition est retirée."
msgstr "The proposal is withdrawn."

#: translations/views.py:585
msgid "La proposition est reprise sur le texte actuel."
msgstr "The proposal is carried over to the current text."

#: translations/views.py:586
msgid "Le dernier changement est annulé."
msgstr "The last change is undone."

#: translations/views.py:659
msgid "Le projet est créé."
msgstr "The project has been created."

#: translations/views.py:729
msgid "Choisissez une version publiée de ce projet."
msgstr "Choose a published version of this project."

#: translations/views.py:735
msgid "Le projet n’a plus de version de référence."
msgstr "The project no longer has a reference version."

#: translations/views.py:737
msgid "La version de référence est choisie."
msgstr "The reference version has been chosen."

#: translations/views.py:1023
#, python-format
msgid "%(count)d phrase enregistrée."
